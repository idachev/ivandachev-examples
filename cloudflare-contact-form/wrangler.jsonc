{
  "name": "contact-form-app",
  "compatibility_date": "2024-01-01",
  "pages_build_output_dir": "public",
  
  "kv_namespaces": [
    {
      // this is the name of the variable bind to env.CONTACT_SUBMISSIONS that can be
      // used in your Worker JavaScript code to access the KV namespace functions
      "binding": "CONTACT_SUBMISSIONS",
      // Replace with your actual namespace ID after running: npm run kv:create
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  
  "vars": {
    // Comma-separated list of allowed origins. Each entry must equal the browser's Origin
    // exactly (scheme, host and port, no trailing slash). A POST from any other Origin, or
    // with no Origin, gets 403 and nothing is stored. The site's own origin (including a
    // *.pages.dev preview host) is always allowed and does not need to be listed.
    // In production, set this to your actual domain(s)
    "ALLOWED_ORIGINS": "https://yourdomain.com,https://www.yourdomain.com",

    // Local development only: allow http://localhost:<port> and http://127.0.0.1:<port>.
    // Only the string "true" enables it. Keep it out of the production vars; set it in your
    // local .dev.vars instead:
    // "ALLOW_LOCALHOST": "true",
    
    "MIN_NAME_LENGTH": 2,
    "MAX_NAME_LENGTH": 200,
    "MIN_MESSAGE_LENGTH": 50,
    "MAX_MESSAGE_LENGTH": 8000,

    "SUBMISSION_EXPIRATION_DAYS": 90,

    "RATE_LIMIT_WINDOW_SECONDS": 60,
    "MAX_REQUESTS_PER_IP": 5,

    // Cloudflare Turnstile Site Key
    "TURNSTILE_SITE_KEY": "YOUR_TURNSTILE_SITE_KEY"
  }
  
  // Set API_KEY secret via wrangler CLI:
  // wrangler secret put API_KEY
  // Generate a secure key: openssl rand -hex 32

  // Set TURNSTILE_SECRET_KEY via wrangler CLI (required: without it a POST from an allowed
  // origin returns 500 {"error": "server not configured"} and nothing is stored):
  // wrangler secret put TURNSTILE_SECRET_KEY
}